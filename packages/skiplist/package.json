{
  "name": "@yukino.js/skiplist",
  "version": "0.0.0",
  "description": "A Redis-style skiplist (sorted set) implementation in TypeScript",
  "keywords": [
    "skiplist",
    "sorted-set",
    "redis",
    "data-structure",
    "rank"
  ],
  "license": "MIT",
  "author": "hangtiancheng",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^24.19.2",
    "rollup": "^4.68.7",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
